const SHEET_NAME="Orders";
const HEADERS=["orderId","createdAt","customerName","phone","address","note","itemsJson","total","status","trackingNo"];
function sheet_(){const ss=SpreadsheetApp.getActiveSpreadsheet();let sh=ss.getSheetByName(SHEET_NAME);if(!sh){sh=ss.insertSheet(SHEET_NAME);sh.appendRow(HEADERS);sh.setFrozenRows(1);}return sh;}
function doGet(e){const action=e.parameter.action||"health";if(action==="health")return json_({ok:true,service:"SenZeed Orders API"});if(action==="list"){const sh=sheet_(),v=sh.getDataRange().getValues(),rows=v.slice(1).filter(r=>r[0]).map(r=>({orderId:r[0],createdAt:r[1],customerName:r[2],phone:r[3],address:r[4],note:r[5],items:JSON.parse(r[6]||"[]"),total:r[7],status:r[8],trackingNo:r[9]}));return json_({ok:true,orders:rows.reverse()});}return json_({ok:false,error:"Unknown action"});}
function doPost(e){try{const body=JSON.parse(e.postData.contents);if(body.action==="update"){const sh=sheet_(),v=sh.getDataRange().getValues();for(let i=1;i<v.length;i++){if(v[i][0]===body.orderId){if(body.status)sh.getRange(i+1,9).setValue(body.status);if(body.trackingNo!==undefined)sh.getRange(i+1,10).setValue(String(body.trackingNo).slice(0,80));return json_({ok:true});}}throw new Error("ไม่พบเลขคำสั่งซื้อ");}if(!body.customerName||!body.phone||!body.address||!Array.isArray(body.items)||!body.items.length)throw new Error("ข้อมูลคำสั่งซื้อไม่ครบ");if(body.items.some(x=>!x.sku||!Number.isInteger(x.qty)||x.qty<1||x.qty>100))throw new Error("จำนวนสินค้าไม่ถูกต้อง");const total=body.items.reduce((s,x)=>s+x.qty*Number(x.unitPrice),0);if(total!==Number(body.total))throw new Error("ยอดรวมไม่ถูกต้อง");const id="SZ"+Utilities.formatDate(new Date(),Session.getScriptTimeZone(),"yyMMddHHmmss")+"-"+Math.floor(100+Math.random()*900);sheet_().appendRow([id,new Date(),String(body.customerName).slice(0,100),String(body.phone).slice(0,30),String(body.address).slice(0,1000),String(body.note||"").slice(0,500),JSON.stringify(body.items),total,"รอหยิบ",""]);return json_({ok:true,orderId:id});}catch(err){return json_({ok:false,error:err.message});}}
function json_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);}
